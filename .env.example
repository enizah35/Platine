# Copier en .env et remplir. Ne jamais committer .env.
# Un seul .env sert à deux usages :
#  - docker compose : les valeurs d'hôte ci-dessous (LAVALINK_HOST, DATABASE_URL) sont surchargées
#    dans docker-compose.yml pour pointer vers les conteneurs « lavalink » et « postgres » ;
#  - pnpm dev sur le PC (bot hors conteneur) : utilise les valeurs telles quelles (ports publiés sur 127.0.0.1
#    par docker-compose.dev.yml).

# Application Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Serveur de test : les commandes y sont enregistrées instantanément
DISCORD_GUILD_ID=

# Lavalink
LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
# Mot de passe partagé bot <-> Lavalink : mettre une longue valeur aléatoire
LAVALINK_PASSWORD=change-me
# Tas maximal de la JVM Lavalink (limite du conteneur : 1 Go)
LAVALINK_XMX=768m

# PostgreSQL (conteneur du docker-compose)
POSTGRES_USER=platine
POSTGRES_PASSWORD=change-me
POSTGRES_DB=platine
# Utilisé par le bot hors conteneur ; dans le compose, recalculé à partir des POSTGRES_* ci-dessus
DATABASE_URL=postgres://platine:change-me@127.0.0.1:5432/platine

# Divers
LOG_LEVEL=info
HEALTH_PORT=8080
