# Copier en .env et remplir. Ne jamais committer .env.
# Application Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Serveur de test : les commandes y sont enregistrées instantanément
DISCORD_GUILD_ID=

# Lavalink (conteneur du docker-compose)
LAVALINK_HOST=lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=change-me

# PostgreSQL (conteneur du docker-compose)
DATABASE_URL=postgres://platine:platine@postgres:5432/platine

# Divers
LOG_LEVEL=info
HEALTH_PORT=8080
